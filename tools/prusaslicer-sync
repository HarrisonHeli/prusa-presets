#!/usr/bin/env bash
# prusaslicer-sync — pull shared presets, run PrusaSlicer, commit + push on exit.
#
#   prusaslicer-sync [files/urls...]          launch 2.x  (flatpak branch "stable")
#   prusaslicer-sync --alpha [files/urls...]  launch 3.x  (flatpak branch "beta")
#   prusaslicer-sync --sync                   pull/commit/push only, no launch
#   prusaslicer-sync --status                 show repo state
#
# Both installs share this one repo: 2.x presets live in print/ filament/ ...
# (flatpak .../config/PrusaSlicer), 3.x presets in ps3/ (flatpak .../config/PrusaSlicer3-dev).
#
# Env: PRESETS_REPO (default: dir above this script), PRUSA_CMD (override launcher)
set -uo pipefail

REPO="${PRESETS_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
HOST="$(hostname -s)"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/prusa-presets.log"
APP_ID=com.prusa3d.PrusaSlicer
INSTALL=stable          # stable = 2.x, beta = 3.x alpha
mkdir -p "$(dirname "$LOG")"

log()    { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; [[ -t 2 ]] && echo "$*" >&2; return 0; }
notify() {
  log "NOTIFY: $*"
  # desktop notification if a notification daemon is up; else a zenity dialog; else xmessage
  if command -v notify-send >/dev/null && notify-send -a PrusaSlicer -i com.prusa3d.PrusaSlicer "Preset sync" "$*" 2>/dev/null; then return 0; fi
  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || return 0
  if command -v zenity >/dev/null; then
    (zenity --warning --title="PrusaSlicer preset sync" --width=420 --text="$*" >/dev/null 2>&1 &)
  elif command -v xmessage >/dev/null; then
    (xmessage -center "PrusaSlicer preset sync: $*" >/dev/null 2>&1 &)
  fi
  return 0
}
g()      { git -C "$REPO" "$@"; }

branch_of() { [[ "$1" == beta ]] && echo beta || echo stable; }
install_tag() { [[ "$INSTALL" == beta ]] && echo "3.x" || echo "2.x"; }

prusa_version() {
  local br; br="$(branch_of "$INSTALL")"
  if [[ -n "${PRUSA_CMD:-}" ]]; then echo "custom"
  elif flatpak info "$APP_ID//$br" >/dev/null 2>&1; then
    flatpak info "$APP_ID//$br" | awk -F: '/^ *Version:/{gsub(/^ +/,"",$2); print $2; exit}'
  elif command -v prusa-slicer >/dev/null; then
    prusa-slicer --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[^ ]*' || echo unknown
  else echo none; fi
}

# Which install class owns a .machines/ file:  <host> = 2.x,  <host>.ps3 = 3.x
machines_file() {
  if [[ "$INSTALL" == beta ]]; then echo "$REPO/.machines/$HOST.ps3"
  else echo "$REPO/.machines/$HOST"; fi
}

commit_local() {
  # record this machine's PrusaSlicer version so mismatches are visible
  local mf; mf="$(machines_file)"
  mkdir -p "$REPO/.machines"
  local v; v="$(prusa_version)"
  [[ "$(cat "$mf" 2>/dev/null)" == "$v" ]] || echo "$v" >"$mf"
  g add -A
  if ! g diff --cached --quiet; then
    local files; files="$(g diff --cached --name-only | grep -v '^\.machines/' | sed 's#\.\(ini\|yaml\)$##' | paste -sd, - | cut -c1-120)"
    g commit -q -m "${files:-machine info} [$HOST $(install_tag)]" && log "committed: ${files:-machine info}"
  fi
}

check_versions() {
  local mine; mine="$(prusa_version)"; local f name h other
  for f in "$REPO"/.machines/*; do
    [[ -f "$f" ]] || continue
    name="$(basename "$f")"
    # only compare within the same install class (2.x with 2.x, 3.x with 3.x)
    if [[ "$INSTALL" == beta ]]; then
      [[ "$name" == *.ps3 ]] || continue
      h="${name%.ps3}"
    else
      [[ "$name" == *.ps3 ]] && continue
      h="$name"
    fi
    [[ "$h" == "$HOST" ]] && continue
    other="$(cat "$f")"
    if [[ "$other" != "$mine" && "$other" != custom && "$mine" != custom ]]; then
      notify "Version mismatch ($(install_tag)): $HOST has $mine, $h has $other. Newer versions may write settings older ones ignore."
      return
    fi
  done
}

sync_repo() {   # $1 = pull|push|both
  [[ -e "$REPO/.git" ]] || { notify "No presets repo at $REPO"; return 1; }
  if [[ -e "$REPO/.git/rebase-merge" || -e "$REPO/.git/rebase-apply" ]]; then
    notify "Presets repo has an unresolved conflict — fix it in $REPO (git status). Not syncing."; return 1
  fi
  commit_local
  g remote get-url origin >/dev/null 2>&1 || { log "no remote configured; local commits only"; return 0; }
  if ! timeout 20 git -C "$REPO" fetch -q origin 2>>"$LOG"; then
    log "offline/fetch failed — using local presets"; return 0
  fi
  local br; br="$(g symbolic-ref --short HEAD)"
  if g rev-parse -q --verify "origin/$br" >/dev/null; then
    if ! g rebase -q "origin/$br" >>"$LOG" 2>&1; then
      local cf; cf="$(g diff --name-only --diff-filter=U | paste -sd, -)"
      g rebase --abort
      notify "Conflict in: $cf. Another machine changed the same setting. Your version is kept locally and NOT pushed. Resolve: cd $REPO && git pull --rebase"
      return 1
    fi
  fi
  if [[ "$1" != pull ]] && [[ -n "$(g log --oneline "origin/$br..HEAD" 2>/dev/null || echo new)" ]]; then
    if timeout 30 git -C "$REPO" push -q origin "$br" 2>>"$LOG"; then log "pushed"
    else notify "Push failed — changes are committed locally and will push next time."; fi
  fi
  return 0
}

# Is an instance of this install class running?  Both branches use the same
# app id, so match the in-sandbox binary name rather than the app id.
proc_running() {   # $1 = stable|beta
  if [[ "$1" == beta ]]; then pgrep -f '[/]slic3r-app-launcher' >/dev/null
  else pgrep -f '[/]prusa-slicer' >/dev/null; fi
}

launch() {
  local br; br="$(branch_of "$INSTALL")"
  if [[ -n "${PRUSA_CMD:-}" ]]; then $PRUSA_CMD "$@"
  elif [[ "$INSTALL" == beta ]]; then
    flatpak run --branch=beta --command=/app/bin/slic3r-app-launcher --file-forwarding "$APP_ID" \
      --single-instance-on-url @@u "$@" @@
  elif flatpak info "$APP_ID//stable" >/dev/null 2>&1; then
    flatpak run --branch=stable --command=entrypoint --file-forwarding "$APP_ID" \
      --single-instance-on-url @@u "$@" @@
  elif command -v prusa-slicer >/dev/null; then
    prusa-slicer --single-instance-on-url "$@"
  else notify "PrusaSlicer ($(install_tag)) not found"; return 127; fi
}

# --- argument parsing -------------------------------------------------------
case "${1:-}" in
  --alpha|--beta|--3x|--3) INSTALL=beta; shift ;;
  --stable|--2x|--2)       INSTALL=stable; shift ;;
esac

case "${1:-}" in
  --sync)   sync_repo both; exit ;;
  --status)
    g status -sb; echo; g log --oneline -10; echo; echo "machines:"
    grep -H . "$REPO"/.machines/* 2>/dev/null
    echo; echo "installed:"
    for b in stable beta; do
      if flatpak info "$APP_ID//$b" >/dev/null 2>&1; then
        printf '  %-6s %s\n' "$b" "$(flatpak info "$APP_ID//$b" | awk -F: '/^ *Version:/{gsub(/^ +/,"",$2); print $2; exit}')"
      fi
    done
    exit ;;
esac

# Already running? Just hand the file/URL to the existing instance — the
# instance that was launched through this wrapper owns the sync on exit.
if proc_running "$INSTALL"; then launch "$@"; exit; fi

sync_repo pull
check_versions
launch "$@"; rc=$?
# --single-instance hands off and returns immediately if another instance
# appeared meanwhile; wait until no PrusaSlicer of this class is left before pushing.
while proc_running "$INSTALL"; do sleep 3; done
sync_repo both
exit $rc
